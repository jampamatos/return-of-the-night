---
import type { Locale } from "../../config/site";
import type { TocGroup } from "../../lib/content/toc";
import type { ChapterAudience } from "../../lib/reader/types";
import BookTocBreadcrumb from "./BookTocBreadcrumb.astro";
import BookTocEmptyState from "./BookTocEmptyState.astro";
import BookTocGroup from "./BookTocGroup.astro";
import BookTocHeader from "./BookTocHeader.astro";

interface Props {
  lang: Locale;
  bookTitle: string;
  bookSubtitle?: string;
  tocLabel: string;
  indexLabel: string;
  archiveLabel: string;
  groups: TocGroup[];
  audienceLabels: Record<"all" | ChapterAudience, string>;
  emptyStateTitle: string;
  emptyStateBody: string;
  emptyGroupLabel: string;
  breadcrumbLabel: string;
  homeHref: string;
  homeLabel: string;
  currentPageLabel: string;
  indexCopy: {
    label: string;
    groups: string;
    entries: string;
    profile: string;
  };
  translationUnavailable?: {
    title: string;
    body: string;
  };
}

const {
  lang,
  bookTitle,
  bookSubtitle,
  tocLabel,
  indexLabel,
  archiveLabel,
  groups,
  audienceLabels,
  emptyStateTitle,
  emptyStateBody,
  emptyGroupLabel,
  breadcrumbLabel,
  homeHref,
  homeLabel,
  currentPageLabel,
  indexCopy,
  translationUnavailable,
} = Astro.props as Props;

const hasTocEntries = groups.some((group) => group.entries.length > 0);
const entryCount = groups.reduce(
  (total, group) => total + group.entries.length,
  0,
);
---

<section class="book-toc" aria-labelledby="book-toc-title">
  <div class="book-toc__layout">
    <div class="book-toc__content">
      <BookTocBreadcrumb
        label={breadcrumbLabel}
        homeHref={homeHref}
        homeLabel={homeLabel}
        currentPageLabel={currentPageLabel}
      />

      <BookTocHeader
        title={bookTitle}
        subtitle={bookSubtitle}
        tocLabel={tocLabel}
        indexLabel={indexLabel}
        archiveLabel={archiveLabel}
      />

      {
        translationUnavailable && (
          <aside
            class="book-toc-translation-notice"
            id="translation-unavailable"
            data-translation-unavailable
            role="status"
            tabindex="-1"
            hidden
          >
            <h2>{translationUnavailable.title}</h2>
            <p>{translationUnavailable.body}</p>
          </aside>
        )
      }

      {
        hasTocEntries ? (
          <div class="book-toc__groups" data-toc-groups>
            {groups.map((group, groupIndex) => (
              <BookTocGroup
                lang={lang}
                group={group}
                index={groupIndex}
                audienceLabels={audienceLabels}
                emptyLabel={emptyGroupLabel}
              />
            ))}
          </div>
        ) : (
          <BookTocEmptyState title={emptyStateTitle} body={emptyStateBody} />
        )
      }
    </div>

    <aside class="book-toc__rail" aria-label={indexCopy.label}>
      <p>{indexCopy.label}</p>
      <dl>
        <div>
          <dt>{indexCopy.groups}</dt>
          <dd data-toc-visible-group-count>{groups.length}</dd>
        </div>
        <div>
          <dt>{indexCopy.entries}</dt>
          <dd data-toc-visible-entry-count>{entryCount}</dd>
        </div>
        <div>
          <dt>{indexCopy.profile}</dt>
          <dd
            data-toc-profile
            data-toc-player-label={audienceLabels.player}
            data-toc-gm-label={audienceLabels.gm}
          >
            {audienceLabels.player}
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<script>
  import { getAudienceOrDefault, type Audience } from "../../config/site";
  import { AUDIENCE_CHANGE_EVENT } from "../../lib/audience/audience-switcher";
  import { isChapterVisibleForAudience } from "../../lib/audience/chapter-visibility";

  const translationUnavailableNotice = document.querySelector<HTMLElement>(
    "[data-translation-unavailable]",
  );

  const updateTranslationUnavailableNotice = () => {
    if (!translationUnavailableNotice) return;

    const isTranslationUnavailable =
      window.location.hash === "#translation-unavailable";

    translationUnavailableNotice.hidden = !isTranslationUnavailable;

    if (isTranslationUnavailable) {
      translationUnavailableNotice.focus();
    }
  };

  updateTranslationUnavailableNotice();
  window.addEventListener("hashchange", updateTranslationUnavailableNotice);

  const tocGroups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-toc-group]"),
  );
  const visibleGroupCount = document.querySelector<HTMLElement>(
    "[data-toc-visible-group-count]",
  );
  const visibleEntryCount = document.querySelector<HTMLElement>(
    "[data-toc-visible-entry-count]",
  );
  const tocProfile = document.querySelector<HTMLElement>("[data-toc-profile]");

  const updateTocForAudience = (audience: Audience) => {
    let visibleGroups = 0;
    let visibleEntries = 0;

    for (const group of tocGroups) {
      const groupAudience = group.dataset.tocGroupAudience ?? "all";
      const entries = Array.from(
        group.querySelectorAll<HTMLElement>("[data-toc-entry]"),
      );
      const groupIsVisible = isChapterVisibleForAudience(
        groupAudience === "gm" || groupAudience === "player"
          ? groupAudience
          : "all",
        audience,
      );

      const visibleEntriesForGroup = entries.filter((entry) => {
        const entryAudience = entry.dataset.tocEntryAudience;
        const entryIsVisible =
          groupIsVisible &&
          isChapterVisibleForAudience(
            entryAudience === "gm" || entryAudience === "player"
              ? entryAudience
              : "all",
            audience,
          );

        entry.hidden = !entryIsVisible;
        return entryIsVisible;
      });

      group.hidden = visibleEntriesForGroup.length === 0;

      if (group.hidden) continue;

      visibleGroups += 1;
      visibleEntries += visibleEntriesForGroup.length;

      const groupIndex = group.querySelector<HTMLElement>(
        "[data-toc-group-index]",
      );
      if (groupIndex)
        groupIndex.textContent = String(visibleGroups).padStart(2, "0");

      visibleEntriesForGroup.forEach((entry, index) => {
        const entryNumber = entry.querySelector<HTMLElement>(
          "[data-toc-entry-number]",
        );
        if (entryNumber)
          entryNumber.textContent = String(index + 1).padStart(2, "0");
      });
    }

    if (visibleGroupCount)
      visibleGroupCount.textContent = String(visibleGroups);
    if (visibleEntryCount)
      visibleEntryCount.textContent = String(visibleEntries);
    if (tocProfile) {
      tocProfile.textContent =
        audience === "gm"
          ? (tocProfile.dataset.tocGmLabel ?? "GM")
          : (tocProfile.dataset.tocPlayerLabel ?? "Player");
    }
  };

  updateTocForAudience(
    getAudienceOrDefault(document.documentElement.dataset.audience),
  );
  document.addEventListener(AUDIENCE_CHANGE_EVENT, (event) => {
    updateTocForAudience((event as CustomEvent<Audience>).detail);
  });
</script>

<style>
  .book-toc {
    padding-left: clamp(var(--space-3), 3vw, var(--space-6));
    border-left: 1px solid var(--border-color);
  }

  .book-toc__layout,
  .book-toc__content {
    display: grid;
    gap: var(--space-5);
  }

  .book-toc__groups {
    display: grid;
    gap: var(--space-4);
  }

  .book-toc__rail {
    display: none;
  }

  .book-toc-translation-notice {
    max-width: 46rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    background: rgba(18, 53, 65, 0.55);
  }

  .book-toc-translation-notice h2 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-ui);
    font-size: 1rem;
  }

  .book-toc-translation-notice p {
    margin: 0;
  }

  @media (max-width: 40rem) {
    .book-toc {
      gap: var(--space-5);
    }

    .book-toc__groups {
      gap: var(--space-4);
    }
  }

  @media (min-width: 40.0625rem) and (max-width: 90rem) {
    .book-toc {
      width: min(100%, 54rem);
      margin-inline: auto;
    }
  }

  @media (min-width: 90.0625rem) {
    .book-toc__layout {
      grid-template-columns: minmax(0, 54rem) minmax(11rem, 14rem);
      justify-content: space-between;
      gap: clamp(var(--space-5), 5vw, var(--space-7));
    }

    .book-toc__rail {
      position: sticky;
      top: calc(var(--space-6) + 5rem);
      display: grid;
      align-content: start;
      gap: var(--space-3);
      padding: var(--space-2) 0 var(--space-2) var(--space-4);
      border-left: 1px solid var(--accent-primary);
    }

    .book-toc__rail > p,
    .book-toc__rail dt,
    .book-toc__rail dd {
      margin: 0;
      font-family: var(--font-ui);
      text-transform: uppercase;
    }

    .book-toc__rail > p {
      color: var(--accent-primary);
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.12em;
    }

    .book-toc__rail > p::before {
      content: "// ";
      color: var(--muted-text-color);
    }

    .book-toc__rail dl {
      display: grid;
      gap: var(--space-3);
      margin: 0;
    }

    .book-toc__rail dl div {
      display: grid;
      gap: var(--space-1);
    }

    .book-toc__rail dt {
      color: var(--muted-text-color);
      font-size: 0.6rem;
      letter-spacing: 0.08em;
    }

    .book-toc__rail dd {
      color: var(--heading-color);
      font-size: 0.76rem;
      letter-spacing: 0.04em;
    }
  }
</style>
