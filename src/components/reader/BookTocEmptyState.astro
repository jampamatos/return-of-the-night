---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props as Props;
---

<div class="book-toc-empty" role="status">
  <h2>{title}</h2>
  <p>{body}</p>
</div>

<style>
  .book-toc-empty {
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: rgba(31, 41, 55, 0.34);
  }

  .book-toc-empty h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.6rem);
  }

  .book-toc-empty p {
    margin: 0;
  }

  @media (max-width: 40rem) {
    .book-toc-empty {
      padding: var(--space-3);
    }
  }
</style>
