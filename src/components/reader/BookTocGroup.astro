---
import type { Locale } from "../../config/site";
import type { TocGroup } from "../../lib/content/toc";
import type { ChapterAudience } from "../../lib/reader/types";
import BookTocEntry from "./BookTocEntry.astro";

interface Props {
  lang: Locale;
  group: TocGroup;
  index: number;
  audienceLabels: Record<ChapterAudience, string>;
  emptyLabel: string;
}

const { lang, group, index, audienceLabels, emptyLabel } = Astro.props as Props;
---

<section
  class="book-toc-group"
  aria-labelledby={`toc-group-${group.id}`}
  data-toc-group
  data-toc-group-audience={group.audience}
>
  <header class="book-toc-group__header">
    <span class="book-toc-group__index" aria-hidden="true" data-toc-group-index>
      {String(index + 1).padStart(2, "0")}
    </span>
    <div>
      <h2 id={`toc-group-${group.id}`}>{group.label}</h2>

      {
        group.description && (
          <p class="book-toc-group__description">{group.description}</p>
        )
      }
    </div>
  </header>

  {
    group.entries.length > 0 ? (
      <ol class="book-toc-group__entries" data-toc-entries>
        {group.entries.map((entry, entryIndex) => (
          <BookTocEntry
            lang={lang}
            entry={entry}
            index={entryIndex}
            audienceLabels={audienceLabels}
          />
        ))}
      </ol>
    ) : (
      <p class="book-toc-group__empty">{emptyLabel}</p>
    )
  }
</section>

<style>
  .book-toc-group {
    position: relative;
    padding: var(--space-6) 0 var(--space-2);
    border-top: 1px solid var(--border-color);
  }

  .book-toc-group__header {
    display: grid;
    grid-template-columns: minmax(3.5rem, 6.5rem) minmax(0, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .book-toc-group__index {
    color: color-mix(in srgb, var(--accent-primary) 30%, transparent);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 6vw, 7rem);
    font-weight: 800;
    line-height: 0.68;
    letter-spacing: -0.04em;
  }

  .book-toc-group__header h2 {
    margin: 0;
    font-size: clamp(1.7rem, 1.15rem + 1.25vw, 2.7rem);
    font-weight: 700;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .book-toc-group__description {
    margin: 0;
  }

  .book-toc-group__empty {
    margin: 0;
    padding: var(--space-4);
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--muted-text-color);
    background: rgba(10, 15, 20, 0.24);
  }

  .book-toc-group__entries {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 40rem) {
    .book-toc-group__header {
      grid-template-columns: 2.6rem minmax(0, 1fr);
    }

    .book-toc-group__index {
      font-size: 2.5rem;
    }

    .book-toc-group__header h2 {
      font-size: 1.25rem;
    }

    .book-toc-group__empty {
      padding: var(--space-3);
    }
  }
</style>
