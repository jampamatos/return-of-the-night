---
import type { Locale } from "../../config/site";
import type { TocGroup } from "../../lib/content/toc";
import type { ChapterAudience } from "../../lib/reader/types";
import BookTocEntry from "./BookTocEntry.astro";

interface Props {
  lang: Locale;
  group: TocGroup;
  audienceLabels: Record<ChapterAudience, string>;
  emptyLabel: string;
}

const { lang, group, audienceLabels, emptyLabel } = Astro.props as Props;
---

<section class="book-toc-group" aria-labelledby={`toc-group-${group.id}`}>
  <header class="book-toc-group__header">
    <h2 id={`toc-group-${group.id}`}>{group.label}</h2>

    {
      group.description && (
        <p class="book-toc-group__description">{group.description}</p>
      )
    }
  </header>

  {
    group.entries.length > 0 ? (
      <ol class="book-toc-group__entries">
        {group.entries.map((entry, entryIndex) => (
          <BookTocEntry
            lang={lang}
            entry={entry}
            index={entryIndex}
            audienceLabels={audienceLabels}
          />
        ))}
      </ol>
    ) : (
      <p class="book-toc-group__empty">{emptyLabel}</p>
    )
  }
</section>

<style>
  .book-toc-group {
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: rgba(31, 41, 55, 0.34);
  }

  .book-toc-group__header {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .book-toc-group__header h2 {
    margin: 0;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.8rem);
  }

  .book-toc-group__description {
    margin: 0;
  }

  .book-toc-group__empty {
    margin: 0;
    padding: var(--space-4);
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--muted-text-color);
    background: rgba(10, 15, 20, 0.24);
  }

  .book-toc-group__entries {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 40rem) {
    .book-toc-group {
      padding: var(--space-4);
    }

    .book-toc-group__header h2 {
      font-size: 1.25rem;
    }

    .book-toc-group__empty {
      padding: var(--space-3);
    }
  }
</style>
