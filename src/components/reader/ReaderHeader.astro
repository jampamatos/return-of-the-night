---
interface Props {
  title: string;
  eyebrow: string;
  summary: string;
  tocHref: string;
  backToTocLabel: string;
}

const { title, eyebrow, summary, tocHref, backToTocLabel } =
  Astro.props as Props;
---

<header class="reader-header">
  <p class="reader-header__eyebrow">{eyebrow}</p>

  <h1 id="reader-route-title">{title}</h1>

  <p>{summary}</p>
  <a class="reader-header__toc-link" href={tocHref}>
    {backToTocLabel}
  </a>
</header>

<style>
  .reader-header {
    display: grid;
    max-width: 44rem;
    gap: var(--space-4);
    padding: var(--space-3) 0 var(--space-6);
    border-bottom: 1px solid var(--border-color);
  }

  .reader-header h1,
  .reader-header p {
    margin: 0;
  }

  .reader-header__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .reader-header__toc-link {
    width: fit-content;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
