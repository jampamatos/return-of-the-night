---
interface Props {
  title: string;
  subtitle?: string;
  tocLabel: string;
}

const { title, subtitle, tocLabel } = Astro.props as Props;
---

<header class="book-toc-header">
  <p class="book-toc-header__eyebrow">{tocLabel}</p>
  <h1 id="book-toc-title">{title}</h1>

  {subtitle && <p class="book-toc-header__subtitle">{subtitle}</p>}
</header>

<style>
  .book-toc-header {
    max-width: 46rem;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-color);
  }

  .book-toc-header__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .book-toc-header__subtitle {
    margin-bottom: 0;
    font-size: 1.1rem;
  }

  @media (max-width: 40rem) {
    .book-toc-header {
      padding-bottom: var(--space-4);
    }

    .book-toc-header__eyebrow {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
    }

    .book-toc-header__subtitle {
      font-size: 1rem;
    }
  }
</style>
