---
interface Props {
  title: string;
  subtitle?: string;
  tocLabel: string;
  overviewLabel: string;
  sectionsCountLabel: string;
  entriesCountLabel: string;
  sectionCount: number;
  entryCount: number;
}

const {
  title,
  subtitle,
  tocLabel,
  overviewLabel,
  sectionsCountLabel,
  entriesCountLabel,
  sectionCount,
  entryCount,
} = Astro.props as Props;
---

<header class="book-toc-header">
  <p class="book-toc-header__eyebrow">{tocLabel}</p>
  <h1 id="book-toc-title">{title}</h1>

  {subtitle && <p class="book-toc-header__subtitle">{subtitle}</p>}

  <dl class="book-toc-header__overview" aria-label={overviewLabel}>
    <div>
      <dt>{sectionsCountLabel}</dt>
      <dd>{sectionCount}</dd>
    </div>

    <div>
      <dt>{entriesCountLabel}</dt>
      <dd>{entryCount}</dd>
    </div>
  </dl>
</header>

<style>
  .book-toc-header {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-color);
  }

  .book-toc-header__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .book-toc-header__subtitle {
    margin-bottom: 0;
    font-size: 1.1rem;
  }

  .book-toc-header__overview {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
  }

  .book-toc-header__overview div {
    min-width: 8rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: rgba(10, 15, 20, 0.28);
  }

  .book-toc-header__overview dt {
    margin: 0 0 var(--space-1);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-text-color);
  }

  .book-toc-header__overview dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--heading-color);
  }

  @media (max-width: 40rem) {
    .book-toc-header {
      padding-bottom: var(--space-4);
    }

    .book-toc-header__eyebrow {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
    }

    .book-toc-header__subtitle {
      font-size: 1rem;
    }

    .book-toc-header__overview {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }

    .book-toc-header__overview div {
      min-width: 0;
      padding: var(--space-3);
    }
  }
</style>
