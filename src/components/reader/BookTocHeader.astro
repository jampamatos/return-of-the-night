---
interface Props {
  title: string;
  subtitle?: string;
  tocLabel: string;
  indexLabel: string;
  archiveLabel: string;
}

const { title, subtitle, tocLabel, indexLabel, archiveLabel } =
  Astro.props as Props;
---

<header class="book-toc-header" data-archive-label={archiveLabel}>
  <p class="book-toc-header__eyebrow">{indexLabel} // {tocLabel}</p>
  <h1 id="book-toc-title">{title}</h1>

  {subtitle && <p class="book-toc-header__subtitle">{subtitle}</p>}
</header>

<style>
  .book-toc-header {
    position: relative;
    max-width: 46rem;
    padding: var(--space-4) 0 var(--space-5);
    border-bottom: 1px solid var(--border-color);
  }

  .book-toc-header::after {
    content: attr(data-archive-label);
    position: absolute;
    right: 0;
    bottom: var(--space-2);
    color: var(--border-color-strong);
    font-family: var(--font-ui);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .book-toc-header__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .book-toc-header__subtitle {
    margin-bottom: 0;
    max-width: 40rem;
    font-size: 1.06rem;
    line-height: 1.55;
  }

  .book-toc-header h1 {
    max-width: 11ch;
    font-size: clamp(3.4rem, 2.15rem + 4.6vw, 6.3rem);
    font-weight: 700;
    letter-spacing: 0.015em;
    line-height: 0.86;
    text-transform: uppercase;
  }

  @media (max-width: 40rem) {
    .book-toc-header {
      padding-bottom: var(--space-4);
    }

    .book-toc-header__eyebrow {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
    }

    .book-toc-header__subtitle {
      font-size: 1rem;
    }

    .book-toc-header::after {
      display: none;
    }
  }
</style>
