---
import ReaderHeading2 from "./ReaderHeading2.astro";
import ReaderHeading3 from "./ReaderHeading3.astro";
import ReaderFigure from "./rich-content/ReaderFigure.astro";
import ReaderTable from "./rich-content/ReaderTable.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Props {
  Content: AstroComponentFactory;
}

const { Content } = Astro.props as Props;

const readerMdxComponents = {
  figure: ReaderFigure,
  h2: ReaderHeading2,
  h3: ReaderHeading3,
  table: ReaderTable,
};
---

<Content components={readerMdxComponents} />

<style>
  :global(.reader-callout) {
    position: relative;
    display: grid;
    gap: var(--space-2);
    width: 100%;
    margin-block: var(--space-5);
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--reader-callout-border, var(--border-color));
    border-left-width: 0.45rem;
    border-radius: 0;
    background: var(--reader-callout-background, rgba(10, 15, 20, 0.34));
  }

  :global(.reader-callout::before) {
    content: "";
    position: absolute;
    top: -1px;
    right: -1px;
    width: 2.25rem;
    height: 0.24rem;
    background: var(--reader-callout-accent, var(--accent-primary));
  }

  :global(.reader-callout--note) {
    --reader-callout-accent: var(--accent-primary);
    --reader-callout-contrast: var(--accent-primary-contrast);
    --reader-callout-background: color-mix(
      in srgb,
      var(--accent-primary) 6%,
      transparent
    );
    --reader-callout-border: color-mix(
      in srgb,
      var(--accent-primary) 42%,
      var(--border-color)
    );
  }

  :global(.reader-callout--warning) {
    --reader-callout-accent: var(--accent-warning);
    --reader-callout-contrast: var(--accent-warning-contrast);
    --reader-callout-background: color-mix(
      in srgb,
      var(--accent-warning) 7%,
      transparent
    );
    --reader-callout-border: color-mix(
      in srgb,
      var(--accent-warning) 48%,
      var(--border-color)
    );
  }

  :global(.reader-callout--example) {
    --reader-callout-accent: var(--accent-secondary);
    --reader-callout-contrast: var(--accent-secondary-contrast);
    --reader-callout-background: color-mix(
      in srgb,
      var(--accent-secondary) 6%,
      transparent
    );
    --reader-callout-border: color-mix(
      in srgb,
      var(--accent-secondary) 44%,
      var(--border-color)
    );
  }

  :global(.reader-callout > * + *) {
    margin-top: 0;
  }

  :global(.site-main__inner .reader-callout__label) {
    width: fit-content;
    margin: 0;
    padding: 0.18rem 0.48rem;
    border: 1px solid var(--reader-callout-accent, var(--accent-primary));
    color: var(--reader-callout-contrast, var(--accent-primary-contrast));
    background: var(--reader-callout-accent, var(--accent-primary));
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  :global(.reader-callout > :last-child) {
    margin-bottom: 0;
  }

  :global(.reader-audience) {
    --reader-audience-accent: var(--accent-primary);
    --reader-audience-contrast: var(--accent-primary-contrast);
    --reader-audience-background: color-mix(
      in srgb,
      var(--accent-primary) 6%,
      transparent
    );
    position: relative;
    display: grid;
    gap: var(--space-3);
    width: 100%;
    margin-block: var(--space-5);
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--border-color-strong);
    border-left: 0.45rem solid var(--reader-audience-accent);
    border-radius: 0;
    background: var(--reader-audience-background);
  }

  :global(.reader-audience--gm) {
    --reader-audience-accent: var(--accent-secondary);
    --reader-audience-contrast: var(--accent-secondary-contrast);
    --reader-audience-background: color-mix(
      in srgb,
      var(--accent-secondary) 6%,
      transparent
    );
  }

  :global(.site-main__inner .reader-audience__label) {
    width: fit-content;
    margin: 0;
    padding: 0.15rem 0.42rem;
    border: 1px solid var(--reader-audience-accent);
    color: var(--reader-audience-contrast);
    background: var(--reader-audience-accent);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  :global(.reader-audience > * + *) {
    margin-top: 0;
  }

  :global(.reader-audience > :first-child) {
    margin-top: 0;
  }

  :global(.reader-audience > :last-child) {
    margin-bottom: 0;
  }

  :global(html[data-audience="player"] .reader-audience--gm),
  :global(html[data-audience="gm"] .reader-audience--player) {
    display: none;
  }

  :global(.reader-columns) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: start;
    width: 100%;
    margin-block: var(--space-5);
  }

  :global(.reader-column) {
    min-width: 0;
  }

  :global(.reader-column > :first-child) {
    margin-top: 0;
  }

  :global(.reader-column > :last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 48rem) {
    :global(.reader-columns) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
