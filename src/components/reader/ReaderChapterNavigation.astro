---
import type { ReaderAdjacentLink } from "../../lib/reader/types";

interface Props {
  label: string;
  chapterLabel: string;
  previousChapterLabel: string;
  nextChapterLabel: string;
  previousChapterUnavailableLabel: string;
  nextChapterUnavailableLabel: string;
  previousChapter?: ReaderAdjacentLink;
  nextChapter?: ReaderAdjacentLink;
}

const {
  label,
  chapterLabel,
  previousChapterLabel,
  nextChapterLabel,
  previousChapterUnavailableLabel,
  nextChapterUnavailableLabel,
  previousChapter,
  nextChapter,
} = Astro.props as Props;
---

<footer class="reader-chapter-nav" aria-label={label} data-reader-chapter-nav>
  <a
    class="reader-chapter-nav__link reader-chapter-nav__link--previous"
    href={previousChapter?.href}
    data-reader-nav-link="previous"
    hidden={!previousChapter}
  >
    <span class="reader-chapter-nav__kicker">{previousChapterLabel}</span>
    <span class="reader-chapter-nav__title" data-reader-nav-title>
      {previousChapter?.pageTitle}
    </span>
    <span class="reader-chapter-nav__context" data-reader-nav-context>
      {
        previousChapter &&
          `${chapterLabel} ${previousChapter.chapterNumber} · ${previousChapter.chapterTitle}`
      }
    </span>
  </a>
  <p
    class="reader-chapter-nav__empty"
    data-reader-nav-empty="previous"
    hidden={Boolean(previousChapter)}
  >
    <span class="reader-chapter-nav__kicker">{previousChapterLabel}</span>
    <span>{previousChapterUnavailableLabel}</span>
  </p>

  <a
    class="reader-chapter-nav__link reader-chapter-nav__link--next"
    href={nextChapter?.href}
    data-reader-nav-link="next"
    hidden={!nextChapter}
  >
    <span class="reader-chapter-nav__kicker">{nextChapterLabel}</span>
    <span class="reader-chapter-nav__title" data-reader-nav-title>
      {nextChapter?.pageTitle}
    </span>
    <span class="reader-chapter-nav__context" data-reader-nav-context>
      {
        nextChapter &&
          `${chapterLabel} ${nextChapter.chapterNumber} · ${nextChapter.chapterTitle}`
      }
    </span>
  </a>
  <p
    class="reader-chapter-nav__empty"
    data-reader-nav-empty="next"
    hidden={Boolean(nextChapter)}
  >
    <span class="reader-chapter-nav__kicker">{nextChapterLabel}</span>
    <span>{nextChapterUnavailableLabel}</span>
  </p>
</footer>

<style>
  .reader-chapter-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    width: 100%;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-color);
  }

  .reader-chapter-nav__link,
  .reader-chapter-nav__empty {
    display: grid;
    gap: var(--space-1);
    min-height: 6rem;
    margin: 0;
    padding: var(--space-4) var(--space-3);
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted-text-color);
    text-decoration: none;
  }

  .reader-chapter-nav__link[hidden],
  .reader-chapter-nav__empty[hidden] {
    display: none;
  }

  .reader-chapter-nav__link:hover {
    color: var(--heading-color);
    background: color-mix(in srgb, var(--accent-primary) 6%, transparent);
  }

  .reader-chapter-nav__link--next {
    text-align: right;
    border-left: 1px solid var(--border-color);
  }

  .reader-chapter-nav__link--previous .reader-chapter-nav__kicker::before {
    content: "← ";
  }

  .reader-chapter-nav__link--next .reader-chapter-nav__kicker::after {
    content: " →";
  }

  .reader-chapter-nav__kicker {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .reader-chapter-nav__title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--heading-color);
  }

  .reader-chapter-nav__context {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted-text-color);
  }

  .reader-chapter-nav__empty {
    color: var(--muted-text-color);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    opacity: 0.82;
  }

  @media (max-width: 40rem) {
    .reader-chapter-nav {
      grid-template-columns: minmax(0, 1fr);
    }

    .reader-chapter-nav__link,
    .reader-chapter-nav__empty {
      min-height: 0;
    }

    .reader-chapter-nav__link--next {
      text-align: left;
    }
  }
</style>
