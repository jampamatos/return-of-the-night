---
import type { ReaderSidebarItem } from "../../lib/reader/types";

interface Props {
  label: string;
  emptyLabel: string;
  items: ReaderSidebarItem[];
}

const { label, emptyLabel, items } = Astro.props as Props;
---

<aside class="reader-sidebar" aria-labelledby="reader-sidebar-title">
  <h2 id="reader-sidebar-title">{label}</h2>

  {
    items.length > 0 ? (
      <nav aria-label={label}>
        <ol>
          {items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>

              {item.children.length > 0 && (
                <ol>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href}>{child.label}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <p>{emptyLabel}</p>
    )
  }
</aside>

<style>
  .reader-sidebar {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    border-left: 1px solid var(--accent-primary);
  }

  .reader-sidebar h2 {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .reader-sidebar h2::before {
    content: "// ";
    color: var(--muted-text-color);
  }

  .reader-sidebar nav {
    display: grid;
    gap: var(--space-3);
  }

  .reader-sidebar ol {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reader-sidebar ol ol {
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border-color);
  }

  .reader-sidebar a {
    display: inline-flex;
    color: var(--muted-text-color);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  .reader-sidebar a:hover {
    color: var(--accent-primary-strong);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .reader-sidebar p {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 58rem) {
    .reader-sidebar {
      padding: var(--space-3) 0;
      border-top: 1px solid var(--border-color);
      border-left: 0;
      max-height: 16rem;
      overflow: auto;
    }

    .reader-sidebar nav > ol {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      align-items: start;
    }
  }

  @media (max-width: 40rem) {
    .reader-sidebar {
      max-height: 14rem;
    }
  }
</style>
