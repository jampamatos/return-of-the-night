---
import "../styles/global.css";
import {
  AUDIENCE_STORAGE_KEY,
  DEFAULT_AUDIENCE,
  getLocaleOrDefault,
  type Locale,
} from "../config/site";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = "Return of the Night - an open source digital book platform.",
  lang,
} = Astro.props as Props;

const documentLang: Locale = getLocaleOrDefault(lang);
---

<!doctype html>
<html lang={documentLang} data-audience={DEFAULT_AUDIENCE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script
      is:inline
      define:vars={{
        storageKey: AUDIENCE_STORAGE_KEY,
        fallbackAudience: DEFAULT_AUDIENCE,
      }}
    >
      try {
        const rawValue = window.localStorage.getItem(storageKey);
        const audience =
          rawValue === "player" || rawValue === "gm"
            ? rawValue
            : fallbackAudience;

        document.documentElement.dataset.audience = audience;
      } catch {
        document.documentElement.dataset.audience = fallbackAudience;
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <div class="site-brand">
            <a href={`/${documentLang}/`}>Return of the Night</a>
          </div>

          <div class="site-controls" aria-label="Site preferences">
            <slot name="header-controls" />
          </div>
        </div>
      </header>

      <main class="site-main">
        <div class="site-main__inner">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
