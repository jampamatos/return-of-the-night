---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShellHeaderControls from "../../../components/ui/ShellHeaderControls.astro";
import {
  AUDIENCES,
  LOCALES,
  getLocaleOrDefault,
  type Audience,
  type Locale,
} from "../../../config/site";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const langParam = Astro.params.lang;
const lang: Locale = getLocaleOrDefault(langParam);

const audienceLabels = {
  en: {
    player: "Player",
    gm: "GM",
  },
  "pt-BR": {
    player: "Jogador",
    gm: "Mestre",
  },
} as const satisfies Record<Locale, Record<Audience, string>>;

const pageCopy = {
  en: {
    title: "Return of the Night Shell",
    description: "The shared shell entry point for Return of the Night.",
    heading: "Shell Online",
    body: "This is the first internal checkpoint of the site shell. Language-prefixed routing and the shared frame are already in place, and the deeper reading experience will expand from here.",
    languageSwitcherLabel: "Language",
    audienceSwitcherLabel: "Audience",
  },
  "pt-BR": {
    title: "Shell de Return of the Night",
    description:
      "O ponto de entrada da shell compartilhada de Return of the Night.",
    heading: "Shell Online",
    body: "Este e o primeiro ponto interno da shell do site. A rota com prefixo de idioma e a moldura compartilhada ja estao no lugar, e a experiencia de leitura mais profunda vai crescer a partir daqui.",
    languageSwitcherLabel: "Idioma",
    audienceSwitcherLabel: "Público",
  },
} as const;

const copy = pageCopy[lang];

const audienceOptions = AUDIENCES.map((audience) => ({
  value: audience,
  label: audienceLabels[lang][audience],
  isActive: audience === "player",
}));
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <ShellHeaderControls
    slot="header-controls"
    lang={lang}
    pathname={Astro.url.pathname}
    languageSwitcherLabel={copy.languageSwitcherLabel}
    audienceSwitcherLabel={copy.audienceSwitcherLabel}
    audienceOptions={audienceOptions}
  />

  <section>
    <h1>{copy.heading}</h1>
    <p>{copy.body}</p>
  </section>
  <script>
    import { initAudienceSwitchers } from "../../../lib/audience/audience-switcher";

    initAudienceSwitchers();
  </script>
</BaseLayout>
