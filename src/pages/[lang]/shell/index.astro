---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LOCALES, getLocaleOrDefault, type Locale } from "../../../config/site";
import { buildLocalHref } from "../../../utils/locale-routing";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const langParam = Astro.params.lang;
const lang: Locale = getLocaleOrDefault(langParam);

const pathname = Astro.url.pathname;
const localeLinks = LOCALES.map((locale) => ({
  locale,
  href: buildLocalHref(locale, pathname),
}));

const pageCopy = {
  en: {
    title: "Return of the Night Shell",
    description: "The shared shell entry point for Return of the Night.",
    heading: "Shell Online",
    body: "This is the first internal checkpoint of the site shell. Language-prefixed routing and the shared frame are already in place, and the deeper reading experience will expand from here.",
    languageSwitcherLabel: "Language",
    shellAudience: "Player mode",
  },
  "pt-BR": {
    title: "Shell de Return of the Night",
    description:
      "O ponto de entrada da shell compartilhada de Return of the Night.",
    heading: "Shell Online",
    body: "Este e o primeiro ponto interno da shell do site. A rota com prefixo de idioma e a moldura compartilhada ja estao no lugar, e a experiencia de leitura mais profunda vai crescer a partir daqui.",
    languageSwitcherLabel: "Idioma",
    shellAudience: "Modo Jogador",
  },
} as const;

const copy = pageCopy[lang];
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <div slot="header-controls" class="locale-switcher">
    <span class="locale-switcher__label">{copy.languageSwitcherLabel}</span>

    <nav class="locale-switcher__links" aria-label={copy.languageSwitcherLabel}>
      {
        localeLinks.map(({ locale, href }) => (
          <a href={href} aria-current={locale === lang ? "page" : undefined}>
            {locale}
          </a>
        ))
      }
    </nav>
  </div>

  <section>
    <h1>{copy.heading}</h1>
    <p>{copy.body}</p>
  </section>
</BaseLayout>
