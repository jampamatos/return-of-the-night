---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BookTableOfContents from "../../../components/reader/BookTableOfContents.astro";
import ShellHeaderControls from "../../../components/ui/ShellHeaderControls.astro";
import { getBookConfigEntryByLanguageAndBook } from "../../../lib/content/book-config";
import { groupOrderedChapterEntriesForToc } from "../../../lib/content/toc";
import { listOrderedChapterEntriesByLanguageAndBook } from "../../../lib/content/chapters";
import { TOC_SCOPE } from "../../../lib/content/toc-conventions";
import {
  AUDIENCES,
  LOCALES,
  getLocaleOrDefault,
  type Audience,
  type Locale,
} from "../../../config/site";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const langParam = Astro.params.lang;
const lang: Locale = getLocaleOrDefault(langParam);

const chapterEntries = await listOrderedChapterEntriesByLanguageAndBook({
  lang,
  book: TOC_SCOPE.book,
});

const bookConfigEntry = await getBookConfigEntryByLanguageAndBook({
  lang,
  book: TOC_SCOPE.book,
});

const tocGroups = groupOrderedChapterEntriesForToc(
  chapterEntries,
  bookConfigEntry,
);

const audienceLabels = {
  en: {
    all: "All readers",
    player: "Player",
    gm: "GM",
  },
  "pt-BR": {
    all: "Todos",
    player: "Jogador",
    gm: "Mestre",
  },
} as const satisfies Record<Locale, Record<"all" | Audience, string>>;

const pageCopy = {
  en: {
    title: "Return of the Night Book",
    description: "The book home for Return of the Night",
    heading: "Book Home",
    body: "Browse the current book structure and choose where to start reading.",
    tocLabel: "Table of Contents",
    languageSwitcherLabel: "Language",
    audienceSwitcherLabel: "Audience",
  },
  "pt-BR": {
    title: "Livro de Return of the Night",
    description: "A página inicial do livro de Return of the Night",
    heading: "Home do Livro",
    body: "Explore a estrutura atual do livro e escolha por onde começar a leitura.",
    tocLabel: "Sumário",
    languageSwitcherLabel: "Idioma",
    audienceSwitcherLabel: "Público",
  },
} as const;

const copy = pageCopy[lang];

const bookTitle = bookConfigEntry?.data.bookTitle ?? copy.heading;
const bookSubtitle = bookConfigEntry?.data.bookSubtitle ?? copy.body;
const tocLabel =
  bookConfigEntry?.data.navigation.tableOfContents ?? copy.tocLabel;

const audienceOptions = AUDIENCES.map((audience) => ({
  value: audience,
  label: audienceLabels[lang][audience],
  isActive: audience === "player",
}));
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <ShellHeaderControls
    slot="header-controls"
    lang={lang}
    pathname={Astro.url.pathname}
    languageSwitcherLabel={copy.languageSwitcherLabel}
    audienceSwitcherLabel={copy.audienceSwitcherLabel}
    audienceOptions={audienceOptions}
  />
  <BookTableOfContents
    bookTitle={bookTitle}
    bookSubtitle={bookSubtitle}
    tocLabel={tocLabel}
    groups={tocGroups}
    audienceLabels={audienceLabels[lang]}
  />

  <script>
    import { initAudienceSwitchers } from "../../../lib/audience/audience-switcher";

    initAudienceSwitchers();
  </script>
</BaseLayout>
